# Copia este archivo como .env y completa los valores.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/google-service-account.json

# Los nombres se crean automaticamente si no existen.
GOOGLE_ORDERS_SHEET=Pedidos
GOOGLE_ITEMS_SHEET=Productos

# true envia una confirmacion al cliente despues de guardar el pedido.
SEND_CUSTOMER_CONFIRMATION=true

# Carpeta persistente de la sesion de WhatsApp.
WHATSAPP_AUTH_PATH=.wwebjs_auth

# Para vincular sin QR: codigo de pais + numero, solo digitos.
# Ejemplo de Canada: 19055550123
WHATSAPP_PHONE_NUMBER=

# auto usa el numero cuando existe; qr siempre genera una imagen.
WHATSAPP_PAIRING_MODE=auto

# WhatsApp representa CAD 3.50 como 3500 en los carritos.
WHATSAPP_PRICE_DIVISOR=1000

BRAMPTON_DELIVERY_FEE=5
MISSISSAUGA_DELIVERY_FEE=8

# Panel administrativo, disponible solo en esta computadora.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3030
