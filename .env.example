# Copia este archivo como .env y completa los valores.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/google-service-account.json

# Los nombres se crean automaticamente si no existen.
GOOGLE_ORDERS_SHEET=Pedidos
GOOGLE_ITEMS_SHEET=Productos
GOOGLE_PRODUCTION_SHEET=Produccion
GOOGLE_KITCHEN_SHEET=Pedidos para cocina
KITCHEN_SYNC_SECONDS=30

# true envia una confirmacion al cliente despues de guardar el pedido.
SEND_CUSTOMER_CONFIRMATION=true

# Carpeta persistente de la sesion de WhatsApp.
WHATSAPP_AUTH_PATH=.wwebjs_auth

# Para vincular sin QR: codigo de pais + numero, solo digitos.
# Ejemplo de Canada: 19055550123
WHATSAPP_PHONE_NUMBER=
ADMIN_COMMAND_ALLOWED_PHONE=

# auto usa el numero cuando existe; qr siempre genera una imagen.
WHATSAPP_PAIRING_MODE=auto

# WhatsApp representa CAD 3.50 como 3500 en los carritos.
WHATSAPP_PRICE_DIVISOR=1000

BRAMPTON_DELIVERY_FEE=5
MISSISSAUGA_DELIVERY_FEE=8
PICKUP_TIME_WINDOW=5:00 p.m. a 6:00 p.m.
PICKUP_ADDRESS=154 Royal Palm Dr, Brampton

# Seguridad: sin IDs aqui, el bot no automatiza ningun chat.
# Acepta varios IDs separados por coma, por ejemplo 123@lid,15551234567@c.us
WHATSAPP_AUTOMATION_ALLOWLIST=
WHATSAPP_AUTOMATION_ALLOWED_PHONES=
AUTO_REPLY_COOLDOWN_HOURS=24
AUTO_REPLY_STATE_FILE=.data/auto-reply-state.json
BOT_PAUSE_STATE_FILE=.data/bot-pause-state.json

# Flujo conversacional de pedidos.
CONVERSATION_STATE_FILE=.data/conversation-state.json
# Los pedidos incompletos se recuperan desde el inicio despues de este tiempo.
CONVERSATION_SESSION_TIMEOUT_HOURS=24
ADMIN_CONFIG_FILE=.data/admin-config.json
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3090
# Opcional cuando el panel se expone fuera de esta computadora.
ADMIN_PASSWORD=

# Inteligencia artificial para entender mensajes naturales.
# Crea una llave de proyecto en https://platform.openai.com/api-keys
# Nunca compartas esta llave ni la subas a GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=20000
AI_ASSISTANT_ENABLED=true
# El agente conduce toda la venta con herramientas validadas por el servidor.
AI_AGENT_MODE=true
AGENT_MAX_STEPS=6
AGENT_TRANSCRIPT_TURNS=12

MINIMUM_ORDER_PIECES=5
CHOCOLATE_CONCHA_PRICE=3.50
VANILLA_CONCHA_PRICE=3.50
BOLILLO_PRICE=2.50
WEDNESDAY_DELIVERY_WINDOW=después de las 3:00 PM
SATURDAY_DELIVERY_WINDOW=después de las 10:00 AM
